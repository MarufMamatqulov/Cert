# Server porti
PORT=3000

# Sessiya kaliti (tasodifiy murakkab qator)
SESSION_SECRET=sertifikat-maxfiy-kalit-2026-xavfsiz

# Boshlang'ich administrator login va paroli
ADMIN_USER=admin
ADMIN_PASS=admin123

# Saytning to'liq ommaviy domeni (QR kod tekshirish havolasi uchun)
BASE_URL=http://localhost:3000

# Chromium yo'li (agar avtomatik aniqlanmasa: masalan C:\Program Files\Google\Chrome\Application\chrome.exe yoki /usr/bin/chromium-browser)
# Bo'sh qoldirilsa Chrome yoki Edge tizimdan avtomatik topiladi
CHROMIUM_PATH=auto

# HTTPS ostida ishlatilsa 1 qiling
SECURE_COOKIE=0
